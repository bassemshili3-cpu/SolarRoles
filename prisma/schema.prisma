generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model JobAlert {
  id         String    @id @default(cuid())
  email      String
  what       String
  where      String
  frequency  String    @default("WEEKLY")
  salaryMin  String?
  active     Boolean   @default(true)
  lastSentAt DateTime?
  createdAt  DateTime  @default(now())

  @@unique([email, what, where], name: "email_what_where")
}
model Job {
  id            String   @id
  source        String
  title         String
  company       String   @default("")
  location      String   @default("")
  addressRegion String   @default("")
  description   String   @db.Text
  url           String
  applyUrl      String   @default("")
  salaryMin     Int?
  salaryMax     Int?
  salary        String?
  contractType  String?
  contractTime  String?
  postedAt      DateTime?
  fetchedAt     DateTime @default(now())
  expiresAt     DateTime
  active        Boolean  @default(true)

  @@index([source])
  @@index([active])
  @@index([fetchedAt])
  @@index([title, company])
}