generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


model JobAlert {
  id         String    @id @default(cuid())
  email      String
  what       String
  where      String
  frequency  String    @default("WEEKLY")
  salaryMin  String?
  active     Boolean   @default(true)
  lastSentAt DateTime?
  createdAt  DateTime  @default(now())

  @@unique([email, what, where], name: "email_what_where")
}

model NewsletterSubscriber {
  id         String   @id @default(cuid())
  email      String   @unique
  active     Boolean  @default(true)
  sentSlugs  String[]
  createdAt  DateTime @default(now())
  lastSentAt DateTime?
}

model Job {
  id                       String   @id @default(cuid())
  source         String
  title          String
  company        String    @default("")
  location       String    @default("")
  addressRegion  String    @default("")
  description    String    @db.Text
  url            String
  applyUrl       String    @default("")
  salaryMin      Int?
  salaryMax      Int?
  salary         String?
  contractType   String?
  contractTime   String?
  postedAt       DateTime?
  fetchedAt      DateTime  @default(now())
  expiresAt      DateTime
  active         Boolean   @default(true)
  sourcePriority Int       @default(99)
  isFifo Boolean @default(false)
  postedByUserId String?
  schemaDescription        String?
  schemaDescriptionVersion Int      @default(0)

  @@index([postedByUserId])
  @@index([isFifo])
    @@index([active])
  @@index([fetchedAt])
  @@index([title, company])
  @@index([sourcePriority, fetchedAt])
}
model RoleStateDemand {
  id        String   @id @default(cuid())
  roleSlug  String
  state     String
  count     Int
  updatedAt DateTime @updatedAt

  @@unique([roleSlug, state])
  @@index([roleSlug])
}