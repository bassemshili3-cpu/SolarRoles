generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model JobAlert {
  id         String    @id @default(cuid())
  email      String
  what       String
  where      String
  salaryMin  String?
  active     Boolean   @default(true)
  lastSentAt DateTime?
  createdAt  DateTime  @default(now())


  @@unique([email, what, where], name: "email_what_where")
}