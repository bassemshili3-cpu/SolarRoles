# ─── Google Indexing API ──────────────────────────────────────────────────────
# Utilisé par le cron /api/cron/google-indexing pour soumettre les jobs ATS
# (greenhouse, lever, workday…) à l'API Google Indexing.
# Copie ces valeurs depuis le fichier JSON du compte de service Google Cloud
# (champs "client_email" et "private_key" — la clé contient des \n littéraux,
#  on les garde tels quels, le code les transforme en retours à la ligne).

GOOGLE_INDEXING_CLIENT_EMAIL=ton-compte-de-service@projet-indexing.iam.gserviceaccount.com
GOOGLE_INDEXING_PRIVATE_KEY=

# ⚠️ IMPORTANT : le compte de service doit être ajouté comme "Propriétaire" de
# la propriété https://solarroles.com/ dans Google Search Console, sinon
# l'API renverra une erreur 403 (site not verified).
# Quota : 200 URLs/jour (google-200) — le cron est calibré là-dessus.
LINKUP_API_KEY=

# Contact sender must use a Resend-verified domain.
RESEND_FROM_EMAIL=SolarRoles <noreply@solarroles.com>
# Server-only random secret (at least 32 bytes) for signed recovery-session cookies.
AUTH_COOKIE_SECRET=
