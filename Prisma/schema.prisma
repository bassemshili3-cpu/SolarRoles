generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model JobAlert {
  id         String    @id @default(cuid())
  email      String
  what       String
  where      String
  salaryMin  String?
  active     Boolean   @default(true)
  lastSentAt DateTime?
  createdAt  DateTime  @default(now())
}